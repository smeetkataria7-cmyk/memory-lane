# Copy to .env and fill in from your Supabase project:
# Supabase dashboard -> Project Settings -> Data API (URL)
#                    -> Project Settings -> API Keys (key)
#
# Use the PUBLISHABLE key (sb_publishable_..., older projects call this
# the anon/public key). It is meant to ship inside the app - row-level
# security is what protects the data.
#
# Never put the SECRET key (sb_secret_..., older projects: service_role)
# in here. It bypasses row-level security entirely.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here
