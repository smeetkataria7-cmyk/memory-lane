{
  "expo": {
    "name": "Memory Lane",
    "slug": "memory-lane",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "memorylane",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.smeetkataria.memorylane",
      "adaptiveIcon": {
        "backgroundColor": "#131220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f1f2f7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#131220"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Memory Lane uses your photos so you can keep one with the day you're saving.",
          "cameraPermission": "Memory Lane uses your camera so you can capture the day you're saving."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Memory Lane uses your microphone so you can leave a voice note on a day."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MemoryTree",
              "label": "Memory tree",
              "description": "Your streak, leafed in the colours of your days.",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodayOrb",
              "label": "Today's orb",
              "description": "Today's memory orb, or a nudge to fill it in.",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
